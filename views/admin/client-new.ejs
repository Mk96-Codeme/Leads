<%- include('../partials/head', { title: 'New Client — Admin' }) %>
<body>
<div class="site">
  <%- include('../partials/dash-topnav', { role: 'admin', label: 'Dispatch' }) %>

  <div class="dash-shell">
    <%- include('../partials/admin-sidebar', { page }) %>

    <main class="dash-main">
      <div class="dash-header">
        <div>
          <h1>New Client</h1>
          <div class="dash-sub">Create this only after payment is confirmed</div>
        </div>
      </div>

      <% if (createdCredentials) { %>
        <div class="form-success">
          <strong><%= createdCredentials.business_name %> created.</strong><br>
          Hand these credentials to the client (they won't be shown again — reset the password from
          their account page if lost):
          <div class="mono" style="margin-top:10px; font-size:15px;">
            Username: <strong><%= createdCredentials.username %></strong><br>
            Password: <strong><%= createdCredentials.password %></strong>
          </div>
        </div>
        <a href="/admin/clients/<%= createdCredentials.id %>" class="btn btn-outline">View Client</a>
        <a href="/admin/clients/new" class="btn btn-outline">Create Another</a>
      <% } else { %>

        <% if (errors && errors.length) { %>
          <div class="form-errors">
            <strong>Fix the following:</strong>
            <ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul>
          </div>
        <% } %>

        <form method="POST" action="/admin/clients/new" class="panel" style="padding:26px; max-width:760px;">
          <div class="field-row">
            <div class="field">
              <label for="business_name">Business name</label>
              <input type="text" id="business_name" name="business_name" value="<%= values.business_name || '' %>" required>
            </div>
            <div class="field">
              <label for="contact_name">Contact name</label>
              <input type="text" id="contact_name" name="contact_name" value="<%= values.contact_name || '' %>" required>
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" value="<%= values.email || '' %>" required>
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input type="tel" id="phone" name="phone" value="<%= values.phone || '' %>" required>
            </div>
          </div>
          <div class="field">
            <label for="coverage_area">Coverage area</label>
            <input type="text" id="coverage_area" name="coverage_area" value="<%= values.coverage_area || '' %>" required>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="bundle">Bundle</label>
              <select id="bundle" name="bundle">
                <option value="starter">Starter</option>
                <option value="crew">Crew</option>
                <option value="fleet">Fleet</option>
              </select>
            </div>
            <div class="field">
              <label for="username">Login username</label>
              <input type="text" id="username" name="username" value="<%= values.username || '' %>" required>
              <div class="field-hint">A password will be generated automatically.</div>
            </div>
          </div>
          <div class="field">
            <label for="notes">Internal notes (optional)</label>
            <textarea id="notes" name="notes"><%= values.notes || '' %></textarea>
          </div>
          <button type="submit" class="btn">Create Client &amp; Generate Login</button>
        </form>
      <% } %>
    </main>
  </div>
</div>
</body>
</html>
