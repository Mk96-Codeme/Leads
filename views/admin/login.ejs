<%- include('../partials/head', { title: 'Dispatch Admin Login' }) %>
<body>
<div class="site">
  <header class="topnav">
    <div class="wrap topnav-inner">
      <a href="/" class="brand">
        <span class="brand-mark"></span>
        DispatchLeads
        <span class="brand-sub">DISPATCH-ADMIN</span>
      </a>
    </div>
  </header>

  <div class="auth-shell">
    <div class="auth-box">
      <h1>Dispatch Admin</h1>
      <p class="auth-sub">Owner-only. Manages leads, clients, and pricing.</p>

      <% if (error) { %>
        <div class="form-errors"><%= error %></div>
      <% } %>

      <form method="POST" action="/admin/login">
        <div class="field">
          <label for="username">Username</label>
          <input type="text" id="username" name="username" required autofocus>
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required>
        </div>
        <button type="submit" class="btn btn-block">Log In</button>
      </form>
    </div>
  </div>
</div>
</body>
</html>
